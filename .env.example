# Copy to .env for local use, or set these in Netlify → Site configuration → Environment variables.
# NEVER commit real values. None of these are exposed to the browser.

# --- Google Calendar (required for online booking) ---
GOOGLE_CALENDAR_ID=            # e.g. abc123@group.calendar.google.com (Calendar settings → Integrate calendar)
GOOGLE_CALENDAR_CREDENTIALS=   # the service-account key JSON, raw or base64-encoded
# …or instead of the JSON:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=   # with literal \n line breaks

# --- Booking links (required) ---
BOOKING_SIGNING_SECRET=        # long random string: `openssl rand -base64 32`

# --- Email confirmations (optional, recommended) ---
RESEND_API_KEY=
EMAIL_FROM=                    # e.g. "STL Demolition & Junk Removal <bookings@stlouishjr.com>" (verified domain)
COMPANY_NOTIFY_EMAIL=          # defaults to the email in config/business.json

# --- SMS alert to the company (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                   # +1314…
COMPANY_NOTIFY_SMS=            # +1314…

# --- Address verification (optional) ---
GOOGLE_MAPS_API_KEY=           # Geocoding API

# --- Live Google reviews (optional; also set source:"google-places" in config/reviews.json) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Overrides (optional; config/*.json is the default source) ---
# PRICE_QUARTER_LOAD=
# PRICE_HALF_LOAD=
# PRICE_THREE_QUARTER_LOAD=
# PRICE_FULL_LOAD=
# BOOKING_DURATION=            # minutes, overrides every load's duration
# BOOKING_CREWS=               # how many jobs can overlap
# BUSINESS_HOURS=              # JSON, e.g. {"sat":["08:00","14:00"]}
# SITE_URL=                    # origin used in emailed links

# --- Local development only ---
# MOCK_CALENDAR=1              # simulated calendar, UI labels it "Demo mode". Ignored in production.
