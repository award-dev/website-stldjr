---
import '../styles/global.css';
import '../styles/media.css';
import '../styles/intro.css';
import '../styles/legacy.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { business as cfg, booking, openingHoursSchema, anyPrice } from '../lib/site';
import { site, services } from '../data/site';
import { locations, cityHref } from '../lib/locations';
import { content } from '../data/content';
import { jobImage } from '../lib/images';
import Intro from '../components/Intro.astro';
import logoMeta from '../assets/brand/logo.png';
// Same files the @fontsource CSS points at (Vite gives them the same hashed URL), preloaded so the headline
// font arrives with the page instead of after the stylesheet is parsed.
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
// Link-preview card: made by scripts/og-card.mjs from the finished intro screen (a placeholder until then).
import shareCard from '../assets/brand/og-card.png';
import truckBed from '../assets/brand/intro-truck-bed.png';
import truckBase from '../assets/brand/intro-truck-base.png';

interface Crumb { name: string; href: string }
interface Props {
  /** Page title; the brand is appended. Omit on the home page. */
  title?: string;
  description: string;
  /** Job photo path (relative to src/assets/jobs) used as the business image in structured data */
  ogImage?: string;
  ogAlt?: string;
  /** Extra JSON-LD nodes for this page */
  schema?: Record<string, unknown>[];
  breadcrumbs?: Crumb[];
  noindex?: boolean;
  /** Show the closing call-to-action band above the footer */
  cta?: boolean;
  /** Hide the phone quick-action bar (booking and quote flows have their own actions) */
  hideMobileBar?: boolean;
  /** Play the once-per-visit intro on this page (off for booking flows) */
  intro?: boolean;
}
const {
  title,
  description,
  ogImage,
  ogAlt,
  schema = [],
  breadcrumbs,
  noindex = false,
  cta = true,
  hideMobileBar = false,
  intro = true,
} = Astro.props;
const showIntro = content.intro.enabled && intro;

const fullTitle = `${title ?? content.home.title} | ${site.shortName}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
// Business image for structured data: the page's photo if given, else the share card.
const og = ogImage ? await getImage({ src: jobImage(ogImage), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 }) : null;
// Link-preview card: the finished loading screen (logo, "Building your next project"), same on every page.
const card = await getImage({ src: shareCard, width: 1200, height: 630, format: 'jpg', quality: 88 });
const cardUrl = new URL(card.src, site.url).href;
const cardAlt = content.intro.drawing === 'truck'
  ? `${site.name} logo truck with the words ${content.intro.words.join(' ')}`
  : `${site.name} logo with the words ${content.intro.words.join(' ')}`;
const analytics = cfg.analytics;
const ogUrl = og ? new URL(og.src, site.url).href : cardUrl;
const introLogo = await getImage({ src: logoMeta, width: 360, format: 'webp', quality: 90 });
const introTruck = content.intro.drawing === 'truck'
  ? { bed: (await getImage({ src: truckBed, format: 'webp', quality: 90 })).src, base: (await getImage({ src: truckBase, format: 'webp', quality: 90 })).src }
  : undefined;

const businessId = `${site.url}/#business`;
const business = {
  '@type': site.schemaType,
  '@id': businessId,
  name: site.name,
  url: `${site.url}/`,
  telephone: site.phoneE164,
  email: site.email,
  image: ogUrl,
  logo: { '@type': 'ImageObject', url: `${site.url}/logo-512.png`, width: 512, height: 512 },
  ...(site.owner && !site.owner.startsWith('__') ? { founder: { '@type': 'Person', name: site.owner } } : {}),
  slogan: cfg.tagline,
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressRegion: site.region, addressCountry: 'US' },
  ...(cfg.hours.confirmed ? { openingHoursSpecification: openingHoursSchema() } : {}),
  ...(cfg.trust.foundedYear ? { foundingDate: String(cfg.trust.foundedYear) } : {}),
  ...(anyPrice ? { priceRange: '$$' } : {}),
  // Counties and the city, then every place in site-data/locations.json (page and mention tiers alike).
  areaServed: [
    ...site.serviceArea.map((a) => ({ '@type': a.type, name: `${a.name}, ${site.region}`, ...(a.wiki ? { sameAs: a.wiki } : {}) })),
    ...locations.map((l) => ({ '@type': l.kind === 'city' ? 'City' : 'Place', name: `${l.name}, ${l.region}`, ...(l.tier === 'page' ? { url: `${site.url}${cityHref(l)}` } : {}) })),
  ],
  sameAs: [...new Set([...site.sameAs, site.facebook].filter(Boolean))],
  knowsAbout: services.map((s) => s.title),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${site.name} services`,
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, url: `${site.url}/services/${s.slug}/` },
    })),
  },
};
const website = { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: site.name, publisher: { '@id': businessId } };
const crumbs = breadcrumbs && {
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: breadcrumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, site.url).href })),
};
const webpage = {
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: fullTitle,
  description,
  isPartOf: { '@id': `${site.url}/#website` },
  about: { '@id': businessId },
  ...(crumbs ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
};
const graph = { '@context': 'https://schema.org', '@graph': [business, website, webpage, ...(crumbs ? [crumbs] : []), ...schema] };
---
<!doctype html>
<html lang="en-US" class:list={[!showIntro && 'intro-seen']} data-booking-api={booking.crm?.apiBase || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <meta name="theme-color" content="#0b0a09" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={cardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cardUrl} />
    <meta name="twitter:image:alt" content={cardAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
    <script is:inline>(function(){var d=document.documentElement;d.classList.add('js');try{if(sessionStorage.getItem('intro-seen')==='1')d.classList.add('intro-seen');}catch(e){}setTimeout(function(){d.classList.add('intro-seen');},9000);var skip=function(){var i=document.querySelector('.intro');if(i)i.classList.add('is-skipped');};document.addEventListener('click',function(e){if(e.target.closest&&e.target.closest('.intro__skip'))skip();});document.addEventListener('keydown',function(e){if(e.key==='Escape')skip();});})();</script>
    {analytics.provider === 'plausible' && analytics.plausibleDomain && (
      <script is:inline defer data-domain={analytics.plausibleDomain} src="https://plausible.io/js/script.tagged-events.js"></script>
    )}
    {analytics.provider === 'ga4' && analytics.ga4MeasurementId && (
      <>
        <script is:inline define:vars={{ id: analytics.ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          // Manage links carry a private token in the query string; never send it.
          var strip = function (u) { return u.replace(/(\/booking\/)\?.*$/, '$1'); };
          window.gtag('config', id, { anonymize_ip: true, page_location: strip(location.href), page_referrer: strip(document.referrer) });
          // gtag.js is ~180 KB of script: load it on the first interaction (tap, key, scroll), or a few seconds after
          // the page has loaded if there is none, so it never competes with the page itself. Calls made before then
          // wait in dataLayer and are sent when it arrives.
          (function () {
            var loaded = false;
            var load = function () {
              if (loaded) return; loaded = true;
              var s = document.createElement('script');
              s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
              document.head.appendChild(s);
            };
            var idle = function () { setTimeout(function () { (window.requestIdleCallback || function (f) { f() })(load, { timeout: 2000 }); }, 5500); };
            if (document.readyState === 'complete') idle(); else addEventListener('load', idle, { once: true });
            ['pointerdown', 'keydown', 'scroll', 'wheel', 'touchstart'].forEach(function (t) { addEventListener(t, load, { once: true, passive: true }); });
          })();
        </script>
      </>
    )}
  </head>
  <body>
    {showIntro && <Intro truck={introTruck} logo={introLogo.src} words={content.intro.words} stages={content.intro.stages} drawing={content.intro.drawing} />}
    <a href="#main" class="skip">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer cta={cta} />
    <MobileBar hide={hideMobileBar} />
    <div class="toaster" aria-live="polite" aria-atomic="false" data-toaster></div>
    <style>
      .skip { position: fixed; left: 16px; top: -60px; z-index: 200; padding: 10px 16px; border-radius: 999px; background: var(--color-accent); color: var(--color-on-accent); font-weight: 600; transition: top .2s; }
      .skip:focus { top: 12px; }
      main:focus { outline: none; }
    </style>
    <script>
      // Scroll reveal: re-run after every client-side navigation.
      function reveal() {
        document.documentElement.classList.add('js');
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.in)');
        if (!('IntersectionObserver' in window)) { els.forEach((e) => e.classList.add('in')); return; }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((e) => io.observe(e));
      }
      import { initAutoTracking } from '../scripts/analytics';
      initAutoTracking();
      // Full page loads only (no client router, so the booking and pricing scripts always run fresh).
      // Components written for the router listen for astro:page-load, so fire it once here.
      document.addEventListener('astro:page-load', reveal);
      // Deferred module scripts all run before DOMContentLoaded, so every listener is registered by then.
      const fire = () => document.dispatchEvent(new Event('astro:page-load'));
      if (document.readyState === 'complete') fire(); else document.addEventListener('DOMContentLoaded', fire, { once: true });
    </script>
  </body>
</html>
