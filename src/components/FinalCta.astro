---
import Icon from "./Icon.astro";
import LoadViz from "./LoadViz.astro";
import { business, telHref } from "../lib/site";
interface Props { title?: string; sub?: string }
const { title = "Got a mess?", sub = "Let's make it disappear." } = Astro.props;
---
<section class="final dark" aria-labelledby="final-title">
  <div class="wrap final-grid">
  <div class="final-inner">
    <div class="ruler final-ruler" aria-hidden="true"></div>
    <h2 id="final-title" class="display">{title}<span class="final-sub">{sub}</span></h2>
    <div class="cta-row">
      <a href="/book/" class="btn btn--green btn--lg" data-track="cta_click" data-track-cta="book" data-track-location="final">Book a pickup <Icon name="arrow" class="arrow" /></a>
      <a href="/quote/" class="btn btn--ghost btn--lg" data-track="cta_click" data-track-cta="quote" data-track-location="final">Get a quote</a>
    </div>
    <a href={telHref} class="final-phone num" data-track="phone_click" data-track-location="final">{business.phoneDisplay}</a>
  </div>
  <div class="final-viz" aria-hidden="true"><LoadViz fraction={1} tone="dark" /></div>
  </div>
</section>

<style>
  .final { padding: clamp(80px, 12vw, 160px) 0; border-bottom: 1px solid var(--asphalt-line); }
  .final-inner { display: grid; gap: 32px; justify-items: start; }
  .final-ruler { width: 100%; color: var(--on-dark-3); margin-bottom: 16px; }
  .final-grid { display: grid; gap: 48px; align-items: end; }
  @media (min-width: 1020px) { .final-grid { grid-template-columns: 1.2fr 0.8fr; } }
  .final-viz { max-width: 440px; width: 100%; justify-self: end; opacity: 0.95; }
  @media (max-width: 1019px) { .final-viz { display: none; } }
  .final-sub { display: block; color: var(--on-dark-3); }
  .final-phone { font-size: var(--step-3); font-weight: 560; letter-spacing: -0.02em; text-decoration: none; color: var(--on-dark); border-bottom: 1px solid var(--asphalt-line); padding-bottom: 4px; transition: border-color var(--t-fast); }
  .final-phone:hover { border-color: var(--green); }
</style>
