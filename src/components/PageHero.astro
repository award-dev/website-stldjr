---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { jobImage, projectFor, fitWidths, PHOTO_QUALITY } from '../lib/images';
interface Crumb { name: string; href: string }
interface Props {
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  /** Job photo path (relative to src/assets/jobs) */
  photo?: string;
  /** Any other image (e.g. a portrait), with its alt text and focal point */
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
}
const { title, lead, crumbs, photo, image, imageAlt = '', imagePosition = 'center' } = Astro.props;
const p = photo ? projectFor(photo) : null;
const meta = image ?? (p ? jobImage(p.file) : null);
const alt = image ? imageAlt : p?.alt ?? '';
// The backdrop is intentionally blurred, so a small copy is enough; the framed photo stays sharp at real size.
const backdrop = meta ? await getImage({ src: meta, width: 480, format: 'webp', quality: 60 }) : null;
---
<section class:list={['ph', meta && 'ph--photo']}>
  {backdrop && <div class="ph__ambient" aria-hidden="true" style={`background-image:url(${backdrop.src})`}></div>}
  <div class="shell ph__inner">
    <div class="ph__text">
      {crumbs && crumbs.length > 1 && (
        <nav aria-label="Breadcrumb" class="ph__crumbs">
          <ol>
            {crumbs.map((c, i) => <li>{i < crumbs.length - 1 ? <a class="link-u" href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>)}
          </ol>
        </nav>
      )}
      <h1 class="display-lg ph__title">{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <div class="ph__slot"><slot /></div>
    </div>
    {meta && (
      <div class="media ph__photo">
        <Image src={meta} alt={alt} style={`object-position:${imagePosition}`} widths={fitWidths(meta, [480, 720, 960, 1280])} quality={PHOTO_QUALITY} sizes="(min-width: 1024px) 600px, 100vw" loading="eager" fetchpriority="high" />
      </div>
    )}
  </div>
</section>
<style>
  .ph { position: relative; isolation: isolate; overflow: hidden; padding: calc(var(--nav-h) + clamp(48px, 8vw, 112px)) 0 clamp(56px, 7vw, 96px); }
  .ph__ambient { position: absolute; inset: -80px; z-index: -1; background-size: cover; background-position: center; filter: blur(70px) saturate(1.2); opacity: .35; transform: scale(1.1); }
  .ph__ambient::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 40%, var(--color-bg) 92%); }
  .ph__inner { display: grid; gap: 40px 64px; align-items: center; }
  .ph--photo .ph__inner { grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .ph--photo .ph__inner { grid-template-columns: 1.05fr 1fr; } }
  .ph__text { display: grid; gap: 24px; align-content: center; }
  .ph__title { max-width: 14ch; }
  .ph__photo { aspect-ratio: 4 / 3; max-width: 640px; width: 100%; justify-self: end; box-shadow: 0 40px 120px -40px rgb(0 0 0 / .9), 0 0 0 1px rgb(255 255 255 / .08); }
  @media (min-width: 1024px) { .ph__photo { aspect-ratio: 1; } }
  .ph__crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; color: var(--color-muted); }
  .ph__crumbs li + li::before { content: '/'; margin-right: 8px; opacity: .5; }
  .ph__slot:empty { display: none; }
</style>
