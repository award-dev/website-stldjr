---
import { Image } from 'astro:assets';
import BeforeAfter from '../react/BeforeAfter.tsx';
import { jobImage, projectFor, pairs, fitWidths, PHOTO_QUALITY } from '../../lib/images';
import { pairImages } from '../../lib/media';
import { pairTitles } from '../../data/site';
import { jobWhen, type JobRecord } from '../../lib/jobs';

interface Props { jobs: JobRecord[] }
const { jobs } = Astro.props;
const pairList = pairs();
const ready = await Promise.all(jobs.map(async (j) => ({
  ...j,
  when: jobWhen(j.date),
  photos: j.photos.map(projectFor),
  sliders: (await Promise.all(j.pairs.map(async (key) => {
    const p = pairList.find((x) => x.key === key);
    if (!p) return null;
    const imgs = await pairImages(p.before, p.after);
    return { key, title: pairTitles[key] ?? `${j.city} before and after`, ...imgs };
  }))).filter((x) => x !== null),
})));
---
<div class="stories">
  {ready.map((j) => (
    <article class="story">
      <p class="story__meta">
        {j.when && <>{j.when} · </>}
        {j.href ? <a class="link-u accent" href={j.href}>{j.city}</a> : j.city}
      </p>
      <p class="story__text">{j.summary}</p>
      {j.sliders.length > 0 && (
        <div class="story__pairs">
          {j.sliders.map((s) => <BeforeAfter client:visible before={s.before} after={s.after} title={s.title} />)}
        </div>
      )}
      {j.photos.length > 0 && (
        <div class="story__photos">
          {j.photos.map((ph) => (
            <div class={`media story__photo${ph.width > ph.height ? ' story__photo--wide' : ''}`}>
              <Image src={jobImage(ph.file)} alt={ph.alt} widths={fitWidths(jobImage(ph.file), [480, 800, 1200])} quality={PHOTO_QUALITY} sizes="(min-width: 900px) 380px, 100vw" loading="lazy" />
            </div>
          ))}
        </div>
      )}
    </article>
  ))}
</div>
<style>
  .stories { display: grid; gap: 36px; }
  .story { display: grid; gap: 12px; }
  .story__meta { font-size: 14px; color: var(--color-muted); }
  .story__text { max-width: 68ch; color: #e3ddd5; }
  .story__pairs { display: grid; gap: 16px; }
  @media (min-width: 900px) { .story__pairs { grid-template-columns: 1fr 1fr; } }
  .story__photos { display: grid; gap: 14px; }
  @media (min-width: 640px) { .story__photos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .story__photo { aspect-ratio: 3 / 4; max-width: 520px; }
  .story__photo--wide { aspect-ratio: 4 / 3; grid-column: 1 / -1; max-width: 760px; }
</style>
