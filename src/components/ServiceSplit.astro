---
import Icon from "./Icon.astro";
import { services } from "../lib/site";
const g = (id: string) => services.groups.find((x) => x.id === id)!;
const columns = [
  { title: "Junk removal & cleanouts", text: "Anything you want gone, from one appliance to a whole house.", groups: [g("junk-removal"), g("cleanouts")] },
  { title: "Demolition & debris", text: "Tear-outs and haul-offs in the same visit, so there's no second mess.", groups: [g("demolition"), g("construction-debris")] },
];
---
<div class="split">
  {columns.map((c, ci) => (
    <div class="col" data-reveal style={`--i:${ci}`}>
      <p class="meta col-num num">{ci === 0 ? "A" : "B"}</p>
      <h3 class="h3">{c.title}</h3>
      <p class="muted col-text">{c.text}</p>
      {c.groups.map((grp) => (
        <div class="grp">
          <a href={grp.path + "/"} class="grp-head">
            <span>{grp.name}</span><Icon name="arrow" size={18} />
          </a>
          <ul role="list" class="grp-items">
            {grp.items.map((it) => <li>{it.name}</li>)}
          </ul>
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  .split { display: grid; gap: 20px; }
  @media (min-width: 900px) { .split { grid-template-columns: 1fr 1fr; } }
  .col { padding: clamp(24px, 4vw, 40px); border-radius: var(--r-4); background: var(--asphalt-2); border: 1px solid var(--asphalt-line); display: grid; gap: 12px; align-content: start; }
  .col-num { color: var(--green); }
  .col-text { margin-bottom: 16px; max-width: 40ch; }
  .grp { border-top: 1px solid var(--asphalt-line); padding: 18px 0 6px; }
  .grp-head { display: flex; justify-content: space-between; align-items: center; font-size: var(--step-1); font-weight: 580; text-decoration: none; }
  .grp-head :global(svg) { color: var(--on-dark-3); transition: transform var(--t-med) var(--ease-out), color var(--t-fast); }
  .grp-head:hover :global(svg) { transform: translateX(3px); color: var(--green); }
  .grp-items { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
  .grp-items li { padding: 5px 10px; border-radius: 6px; background: rgb(255 255 255 / 0.05); font-size: 0.85rem; color: var(--on-dark-2); }
</style>
