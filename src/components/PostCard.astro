---
import { Image } from 'astro:assets';
import { fitWidths, PHOTO_QUALITY } from '../lib/images';
import { postHref, isoDay, longDate, type Post } from '../lib/blog';
interface Props {
  post: Post;
  /** Heading level for the post title (h2 on the blog index, h3 under a section heading) */
  level?: 2 | 3;
  /** First card on the index: load its cover eagerly */
  eager?: boolean;
}
const { post, level = 2, eager = false } = Astro.props;
const d = post.data;
const H = `h${level}` as 'h2' | 'h3';
---
<article class="pc zoom">
  <div class="media pc__media">
    <Image src={d.cover} alt={d.coverAlt} widths={fitWidths(d.cover, [400, 640, 960])} quality={PHOTO_QUALITY} sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" loading={eager ? 'eager' : 'lazy'} />
  </div>
  <div class="pc__body">
    <time class="pc__date" datetime={isoDay(d.date)}>{longDate(d.date)}</time>
    <H class="title pc__title"><a href={postHref(post)} class="pc__link">{d.title}</a></H>
    <p class="muted pc__text">{d.description}</p>
  </div>
</article>
<style>
  .pc { position: relative; display: grid; grid-template-rows: auto 1fr; height: 100%; border-radius: var(--radius-lg); overflow: hidden; background: var(--color-card); box-shadow: inset 0 0 0 1px var(--color-line); transition: box-shadow .3s, transform .45s var(--ease-out-expo); }
  .pc:hover { transform: translateY(-3px); box-shadow: inset 0 0 0 1px rgb(var(--accent-rgb) / .5); }
  .pc__media { aspect-ratio: 4 / 3; border-radius: 0; }
  .pc__body { display: grid; gap: 10px; align-content: start; padding: 22px 24px 26px; }
  .pc__date { font-size: 14px; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .pc__title { margin: 0; }
  /* The title link covers the whole card, so the card is one tap target with one descriptive anchor. */
  .pc__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .pc__link:focus-visible { outline: none; }
  .pc:has(.pc__link:focus-visible) { box-shadow: 0 0 0 3px var(--color-accent); }
  .pc__text { font-size: 15px; line-height: 1.55; }
</style>
