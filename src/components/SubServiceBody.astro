---
/**
 * Body copy for a demolition sub-page. Tokens are filled from config, never typed into the copy:
 *   {minimum} {quarter} {half} {threeQuarter} {full} {maxYards} {heavy} {freon} {access} {minimumRule}
 *   {notAccepted} {confirm} {demoLabor} {examplesNote} {insured}
 *   {fit:<load id>:<words>} -> the matching load example from config/pricing.json ("minimum" included), or nothing.
 * Links are written [text](/path/).
 */
import type { SubService } from '../data/subservices';
import { loads, minimum, pricing, business } from '../lib/site';

interface Props { sub: SubService }
const { sub } = Astro.props;
const byId = (id: string) => (id === 'minimum' ? minimum : loads.find((l) => l.id === id));
const cond = (re: RegExp) => pricing.conditions.find((c: string) => re.test(c)) ?? '';
const tokens: Record<string, string> = {
  quarter: byId('quarter')?.priceLine.amount ?? '',
  half: byId('half')?.priceLine.amount ?? '',
  threeQuarter: byId('three-quarter')?.priceLine.amount ?? '',
  full: byId('full')?.priceLine.amount ?? '',
  maxYards: String(pricing.maxCubicYards),
  minimum: minimum?.priceLine.amount ?? '',
  heavy: cond(/heavy material/i),
  freon: cond(/freon/i),
  access: cond(/difficult access/i),
  minimumRule: cond(/minimum pickup/i),
  notAccepted: cond(/can't take/i),
  confirm: cond(/confirm the final price/i),
  demoLabor: cond(/demolition labor/i),
  examplesNote: pricing.examplesNote,
  insured: business.trust.insured ? `licensed and insured${business.trust.insuranceDetails ? ` with a ${business.trust.insuranceDetails}` : ''}` : 'licensed',
};
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
function fill(s: string) {
  let out = s.replace(/\{fit:([a-z-]+):([^}]+)\}/g, (_, id: string, words: string) => {
    const l = byId(id);
    const f = l?.fits.find((x) => new RegExp(words, 'i').test(x));
    if (!f || !l) return '';
    return id === 'minimum' ? `"${f}" is the kind of pickup our ${l.label.toLowerCase()} covers, at ${l.priceLine.amount}.` : `"${f}" is one of our examples for a ${l.label.toLowerCase()}, from ${l.priceLine.amount}.`;
  });
  return out.replace(/\{(\w+)\}/g, (m, k: string) => (k in tokens ? tokens[k] : m));
}
const html = (s: string) => esc(fill(s)).replace(/\[([^\]]+)\]\((\/[^)\s]*)\)/g, '<a class="link-u accent" href="$2">$1</a>');
---
{sub.sections.map((sec) => (
  <section class="section-tight" aria-labelledby={`${sec.id}-h`}>
    <div class="shell sub-body">
      <h2 id={`${sec.id}-h`} class="display-md">{sec.h2}</h2>
      {sec.body.map((p) => (p.startsWith('<!-- TODO(seo)') ? <Fragment set:html={p} /> : <p set:html={html(p)} />))}
    </div>
  </section>
))}
<style>
  .sub-body { display: grid; gap: 16px; max-width: 72ch; }
</style>
