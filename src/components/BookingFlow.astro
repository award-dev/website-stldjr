  .sum-list dt { color: var(--ink-3); }
  .sum-list dd { margin: 0; font-weight: 520; overflow-wrap: anywhere; }
  .sum-help { border-top: 1px solid var(--line); padding-top: 14px; }

  /* Step transition */
  .bk-step.is-entering { animation: step-in 380ms var(--ease-out) both; }
  .bk-step.is-entering.back { animation-name: step-in-back; }
  @keyframes step-in { from { opacity: 0; transform: translateX(24px); } }
  @keyframes step-in-back { from { opacity: 0; transform: translateX(-24px); } }

  /* Done */
  .bk-done { display: grid; gap: 20px; max-width: 720px; outline: none; }
  .bk-done:not([hidden]) { animation: rise-in 600ms var(--ease-out); }
  .done-mark circle { stroke: var(--green); stroke-width: 2.5; stroke-dasharray: 151; stroke-dashoffset: 151; animation: draw 700ms var(--ease-out) 100ms forwards; }
  .done-mark path { stroke: var(--asphalt); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 36; stroke-dashoffset: 36; animation: draw 400ms var(--ease-out) 600ms forwards; }
  .done-mark svg { background: var(--green-soft); border-radius: 50%; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .done-mark circle, .done-mark path { stroke-dashoffset: 0; animation: none; } }
  .bk-noscript { padding: 20px; border-radius: var(--r-3); background: var(--white); border: 1px solid var(--line); }
</style>

