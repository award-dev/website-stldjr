  /* Review */
  .review { display: grid; border-top: 1px solid var(--line); }
  .terms { display: grid; gap: 12px; padding: 20px; border-radius: var(--r-3); background: var(--paper-2); }
  .terms-list { display: grid; gap: 6px; padding-left: 1.1em; color: var(--ink-2); }
  .check { display: flex; gap: 12px; align-items: flex-start; cursor: pointer; font-weight: 520; padding-top: 6px; }
  .check input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .check-box { flex: none; display: grid; place-items: center; width: 24px; height: 24px; margin-top: -1px; border-radius: 7px; border: 1.5px solid var(--line-strong); background: var(--white); color: transparent; transition: background-color var(--t-fast), border-color var(--t-fast), color var(--t-fast), transform var(--t-fast) var(--ease-out); }
  .check:active .check-box { transform: scale(0.92); }
  .check input:checked + .check-box { background: var(--asphalt); border-color: var(--asphalt); color: var(--on-dark); }
  .check input:focus-visible + .check-box { outline: 2px solid var(--green-ink); outline-offset: 2px; }
  .submit-error { padding: 16px; border-radius: var(--r-2); background: var(--danger-soft); color: #5c140f; }

  /* Actions: sticky on phones so Continue is always under the thumb */
  .bk-actions { position: sticky; bottom: 0; z-index: 4; padding: 12px 0 calc(12px + env(safe-area-inset-bottom)); margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); background: linear-gradient(to top, var(--paper) 70%, transparent); }
  @media (min-width: 1020px) { .bk-actions { position: static; background: none; margin: 0; padding: 8px 0 0; } .bk-actions .btn { width: auto; min-width: 240px; } }

  /* Summary */
  .bk-summary { display: none; }
  @media (min-width: 1020px) {
    .bk-summary { display: grid; gap: 16px; position: sticky; top: calc(var(--header-h) + 80px); padding: 24px; border-radius: var(--r-3); background: var(--white); border: 1px solid var(--line); box-shadow: var(--shadow-1); }
  }
