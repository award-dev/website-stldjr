---
import LoadConfigurator from "./LoadConfigurator.astro";
import NextAvailable from "./NextAvailable.astro";
import Icon from "./Icon.astro";
import { business, telHref, loads, minimum } from "../lib/site";
const fromPrice = loads[0]?.priceLine.amount;
---
<section class="hero dark" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">St. Louis · Demolition + Junk Removal</p>
      <h1 id="hero-title" class="display">
        Point at the mess.
        <span class="hero-accent">We'll handle the rest.</span>
      </h1>
      <p class="lede">
        Junk removal, demolition and cleanouts across St. Louis. You pay for how much of the truck you fill — pick a size, see the price, book a time.
      </p>
      <div class="cta-row hero-ctas">
        <a href="/book/" class="btn btn--green btn--lg" data-track="cta_click" data-track-cta="book" data-track-location="hero">Book a pickup <Icon name="arrow" class="arrow" /></a>
        <a href="/quote/" class="btn btn--ghost btn--lg" data-track="cta_click" data-track-cta="quote" data-track-location="hero">Get a quote</a>
      </div>
      <a href={telHref} class="phone-link hero-phone" data-track="phone_click" data-track-location="hero">
        <Icon name="phone" size={16} /> Or call <span class="num">{business.phoneDisplay}</span>
      </a>
      <NextAvailable />

      <dl class="hero-facts">
        <div><dt class="meta">Pricing</dt><dd>{minimum ? `${minimum.priceLine.amount} minimum · ` : ""}{fromPrice ? `loads from ${fromPrice}` : "by the load"}</dd></div>
        {business.trust.insured && <div><dt class="meta">Coverage</dt><dd>Licensed &amp; insured{business.trust.insuranceDetails ? `, ${business.trust.insuranceDetails.replace(/ million policy$/, "M")}` : ""}</dd></div>}
        {business.trust.completedJobs && <div><dt class="meta">Track record</dt><dd>{business.trust.completedJobs} jobs{business.trust.foundedYear ? ` since ${business.trust.foundedYear}` : ""}</dd></div>}
        <div><dt class="meta">Area</dt><dd>St. Louis City, St. Louis County &amp; St. Charles County</dd></div>
      </dl>
    </div>

    <div class="hero-tool">
      <LoadConfigurator variant="hero" idPrefix="hero" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(40px, 7vw, 96px) 0 clamp(56px, 8vw, 112px);
    overflow: hidden;
  }
  /* Measurement grid, faint, fading out — blueprint without the cliché blue */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px) 0 0 / 48px 48px,
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px) 0 0 / 48px 48px;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 40%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .hero-grid { position: relative; display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1020px) { .hero-grid { grid-template-columns: 1.05fr 0.95fr; gap: 64px; } }
  .hero-copy { display: grid; gap: 24px; align-content: start; }
  .hero h1 { max-width: 11em; }
  .hero-accent { display: block; color: var(--on-dark-3); text-wrap: balance; }
  .hero .lede { max-width: 46ch; }
  .hero-ctas { margin-top: 8px; }
  .hero-phone { color: var(--on-dark-2); font-weight: 500; width: fit-content; }
  .hero-phone:hover { color: var(--on-dark); }
  .hero-facts {
    display: grid;
    grid-template-columns: repeat(2, auto);
    justify-content: start;
    gap: 16px 40px;
    margin-top: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--asphalt-line);
  }
  @media (min-width: 1280px) { .hero-facts { grid-template-columns: repeat(4, auto); gap: 16px 32px; } }
  .hero-facts dt { color: var(--on-dark-3); margin-bottom: 6px; }
  .hero-facts dd { margin: 0; font-size: 0.95rem; color: var(--on-dark); }
  @media (max-width: 559px) {
    .hero-facts { grid-template-columns: 1fr 1fr; }
  }
  .hero-tool { position: relative; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > *, .hero-tool {
      animation: rise 800ms var(--ease-out) both;
    }
    .hero-copy > :nth-child(2) { animation-delay: 60ms; }
    .hero-copy > :nth-child(3) { animation-delay: 120ms; }
    .hero-copy > :nth-child(n + 4) { animation-delay: 180ms; }
    .hero-tool { animation-delay: 220ms; animation-duration: 1000ms; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } }
</style>
