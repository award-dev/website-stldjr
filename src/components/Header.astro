---
import Wordmark from './Wordmark.astro';
import { nav, services, site, primaryAction } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="hd" data-hd>
  <div class="shell hd__bar">
    <a href="/" class="hd__logo" aria-label={`${site.name}, home`}><Wordmark /></a>

    <nav class="hd__nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li class:list={[n.href === '/services/' && 'has-menu']}>
            <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
            {n.href === '/services/' && (
              <div class="hd__menu">
                <ul>
                  {services.map((s) => (
                    <li><a href={`/services/${s.slug}/`}><span>{s.title}</span><small>{s.short}</small></a></li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="hd__actions">
      <a href={site.phoneHref} class="hd__phone" data-track="phone_click" data-track-location="header">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /></svg>
        <span>{site.phone}</span>
      </a>
      <a href={primaryAction.href} class="btn btn-accent hd__cta" data-track="cta_click" data-track-cta="book" data-track-location="header">{primaryAction.label}</a>
      <button type="button" class="hd__toggle" aria-controls="sheet" aria-expanded="false" data-menu>
        <span class="sr-only">Open menu</span>
        <span class="hd__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div id="sheet" class="sheet" hidden>
    <nav class="shell" aria-label="Mobile">
      <ul class="sheet__main">
        <li><a href="/">Home</a></li>
        {nav.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
      <p class="sheet__label">Services</p>
      <ul class="sheet__sub">
        {services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}
      </ul>
      <div class="sheet__cta">
        <a href={primaryAction.href} class="btn btn-accent">{primaryAction.label}</a>
        <a href="/quote/" class="btn btn-ghost">Get a free quote</a>
        <a href={site.phoneHref} class="btn btn-ghost">Call {site.phone}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .hd { position: fixed; inset: 0 0 auto; z-index: 50; height: var(--nav-h); transition: background-color .4s, box-shadow .4s; }
  .hd.is-solid { background: rgb(11 10 9 / .8); backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4); box-shadow: 0 1px 0 rgb(255 255 255 / .07); }
  .hd__bar { height: 100%; display: flex; align-items: center; gap: 28px; }
  .hd__logo { display: flex; flex-shrink: 0; }

  .hd__nav { display: none; height: 100%; }
  .hd__nav > ul { display: flex; height: 100%; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .hd__nav > ul > li { position: relative; display: flex; align-items: center; }
  .hd__nav > ul > li > a { padding: 10px 14px; border-radius: 999px; font-size: 15px; font-weight: 500; color: #d9d2c9; transition: color .2s, background-color .2s; }
  .hd__nav > ul > li > a:hover { color: #fff; background: rgb(255 255 255 / .07); }
  .hd__nav > ul > li > a[aria-current='page'] { color: #fff; background: rgb(255 255 255 / .1); }

  .hd__menu {
    position: absolute; top: calc(100% - 6px); left: -12px; width: 560px; padding: 10px;
    border-radius: var(--radius-lg); background: rgb(22 19 17 / .97); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / .8), inset 0 0 0 1px rgb(255 255 255 / .08);
    opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .25s, transform .35s var(--ease-out-expo), visibility 0s linear .25s;
  }
  .has-menu:hover .hd__menu, .has-menu:focus-within .hd__menu { opacity: 1; visibility: visible; transform: none; transition-delay: .08s, .08s, 0s; }
  .hd__menu ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px; }
  .hd__menu a { display: grid; gap: 2px; padding: 12px 14px; border-radius: 14px; transition: background-color .2s; }
  .hd__menu a:hover { background: rgb(255 255 255 / .06); }
  .hd__menu span { font-weight: 600; }
  .hd__menu small { font-size: 13px; line-height: 1.4; color: var(--color-muted); }

  .hd__actions { margin-left: auto; display: flex; align-items: center; gap: 14px; }
  .hd__phone { display: none; align-items: center; gap: 8px; font-size: 15px; font-weight: 500; color: #e3ddd5; }
  .hd__phone svg { width: 16px; height: 16px; fill: none; stroke: var(--color-accent-ink); stroke-width: 2; }
  .hd__phone:hover { color: #fff; }
  .hd__cta { display: none; min-height: 44px; padding: 0 20px; font-size: 15px; }
  .hd__toggle { width: 44px; height: 44px; display: grid; place-items: center; border: 0; border-radius: 50%; cursor: pointer; background: rgb(255 255 255 / .08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .14); }
  .hd__toggle:hover { background: rgb(255 255 255 / .14); }
  .hd__burger { position: relative; width: 18px; height: 10px; }
  .hd__burger i { position: absolute; left: 0; right: 0; height: 2px; border-radius: 2px; background: #fff; transition: transform .35s var(--ease-out-expo), top .35s var(--ease-out-expo); }
  .hd__burger i:first-child { top: 0; }
  .hd__burger i:last-child { top: 8px; }
  .hd__toggle[aria-expanded='true'] .hd__burger i:first-child { top: 4px; transform: rotate(45deg); }
  .hd__toggle[aria-expanded='true'] .hd__burger i:last-child { top: 4px; transform: rotate(-45deg); }

  .sheet { position: fixed; inset: var(--nav-h) 0 0; overflow-y: auto; padding: 16px 0 40px; background: var(--color-bg); animation: sheet-in .45s var(--ease-out-expo); }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(-10px); } }
  .sheet ul { list-style: none; margin: 0; padding: 0; }
  .sheet__main a { display: block; padding: 8px 0; font-family: var(--font-display); font-weight: 600; font-size: 2.1rem; letter-spacing: -0.03em; }
  .sheet__main a[aria-current='page'] { color: var(--color-accent-ink); }
  .sheet__label { margin: 28px 0 8px; font-size: 14px; color: var(--color-muted); }
  .sheet__sub a { display: block; padding: 12px 0; font-size: 18px; border-bottom: 1px solid var(--color-line); }
  .sheet__cta { display: grid; gap: 10px; margin-top: 32px; }

  @media (min-width: 640px) { .hd__cta { display: inline-flex; } }
  @media (min-width: 1024px) {
    .hd__nav { display: block; }
    .hd__toggle, .sheet { display: none; }
  }
  @media (min-width: 1200px) { .hd__phone { display: inline-flex; } }
</style>

<script>
  function initHeader() {
    const hd = document.querySelector<HTMLElement>('[data-hd]');
    const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
    const sheet = document.getElementById('sheet');
    if (!hd) return;
    const onScroll = () => hd.classList.toggle('is-solid', window.scrollY > 24 || btn?.getAttribute('aria-expanded') === 'true');
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    const setOpen = (open: boolean) => {
      if (!btn || !sheet) return;
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
      sheet.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      onScroll();
    };
    btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    sheet?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); } };
    document.addEventListener('keydown', onKey);
    document.addEventListener('astro:before-swap', () => {
      document.documentElement.style.overflow = '';
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('keydown', onKey);
    }, { once: true });
  }
  document.addEventListener('astro:page-load', initHeader);
</script>
