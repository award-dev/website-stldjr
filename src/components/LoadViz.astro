---
// The truck box in isometric, drawn to scale: 12 × 6.5 × 6 ft ≈ 17 yd³.
// The green block is the load; LoadConfigurator's script re-draws it.
import { boxFaces, pts, project, COS, SIN } from "../lib/iso";

interface Props { fraction?: number; tone?: "paper" | "dark"; labels?: boolean; class?: string }
const { fraction = 0.5, tone = "paper", labels = true, class: cls } = Astro.props;

const L = 12, W = 6.5, H = 6, U = 14;
const OX = 112, OY = 116; // origin offset inside the viewBox
const P = (x: number, y: number, z: number) => project([x, y, z], U, OX, OY);
const line = (a: [number, number, number], b: [number, number, number]) => {
  const [x1, y1] = P(...a); const [x2, y2] = P(...b);
  return { x1: x1.toFixed(1), y1: y1.toFixed(1), x2: x2.toFixed(1), y2: y2.toFixed(1) };
};
const fill = boxFaces(0, 0, 0, L * fraction, W, H * 0.92, U, OX, OY);

// Cab (behind the box in this view)
const G = -1.9; // ground level: the bed sits on the chassis, above the wheels
const cab = boxFaces(-4.6, 0.45, G + 1.0, 4.1, W - 0.9, 7.3, U, OX, OY);
const cabWindow = pts([[-4.3, W - 0.45, 3.3], [-1.2, W - 0.45, 3.3], [-1.2, W - 0.45, 5.6], [-3.6, W - 0.45, 5.6]], U, OX, OY);
const chassis = boxFaces(-4.4, 0.9, G + 0.95, L + 4.0, W - 1.8, -(G + 0.95), U, OX, OY);
const wheelAt = (x: number) => {
  const [ex, ey] = P(x, W - 0.25, G + 0.95);
  return `matrix(${(COS * U).toFixed(3)} ${(SIN * U).toFixed(3)} 0 ${-U} ${ex.toFixed(1)} ${ey.toFixed(1)})`;
};

const ticks = [0.25, 0.5, 0.75, 1].map((f, i) => {
  const [x, y] = P(L * f, 0, H);
  const [x2, y2] = P(L * f, 0, H + 0.7);
  return { x, y, x2, y2, label: ["1/4", "1/2", "3/4", "17 yd³"][i] };
});
const dimL = [P(0, W + 1.2, G), P(L, W + 1.2, G)];
const dimW = [P(L + 1.2, 0, G), P(L + 1.2, W, G)];
---
<svg class:list={["loadviz", `loadviz--${tone}`, cls]} viewBox="0 -8 330 272" role="img" aria-label={`Truck box, ${Math.round(fraction * 100)}% full`} data-loadviz data-l={L} data-w={W} data-h={H} data-u={U} data-ox={OX} data-oy={OY}>
  <!-- ground shadow -->
  <polygon class="lv-shadow" points={pts([[-5.2, -0.3, G], [L + 0.6, -0.3, G], [L + 0.6, W + 0.5, G], [-5.2, W + 0.5, G]], U, OX, OY)} />
  <!-- chassis + cab -->
  <g class="lv-chassis"><polygon points={chassis.top} /><polygon points={chassis.end} /><polygon points={chassis.side} /></g>
  <g class="lv-cab">
    <polygon points={cab.top} /><polygon points={cab.end} /><polygon points={cab.side} />
    <polygon class="lv-window" points={cabWindow} />
  </g>
  <g class="lv-wheels">
    {[-2.6, 2.6, 9.2].map((x) => (
      <g transform={wheelAt(x)}>
        <circle r="0.95" vector-effect="non-scaling-stroke" />
        <circle r="0.38" class="lv-hub" vector-effect="non-scaling-stroke" />
      </g>
    ))}
  </g>  <!-- back faces of the box -->
  <polygon class="lv-back lv-floor" points={pts([[0, 0, 0], [L, 0, 0], [L, W, 0], [0, W, 0]], U, OX, OY)} />
  <polygon class="lv-back" points={pts([[0, 0, 0], [L, 0, 0], [L, 0, H], [0, 0, H]], U, OX, OY)} />
  <polygon class="lv-back lv-back--2" points={pts([[0, 0, 0], [0, W, 0], [0, W, H], [0, 0, H]], U, OX, OY)} />
  <!-- the load -->
  <g class="lv-fill" data-fill>
    <polygon class="lv-fill-side" points={fill.side} data-face="side" />
    <polygon class="lv-fill-end" points={fill.end} data-face="end" />
    <polygon class="lv-fill-top" points={fill.top} data-face="top" />
  </g>
  <!-- near edges of the box -->
  <g class="lv-edges">
    <line {...line([0, W, 0], [L, W, 0])} /><line {...line([L, 0, 0], [L, W, 0])} />
    <line {...line([0, W, H], [L, W, H])} /><line {...line([L, 0, H], [L, W, H])} />
    <line {...line([0, 0, H], [L, 0, H])} /><line {...line([0, 0, H], [0, W, H])} />
    <line {...line([L, W, 0], [L, W, H])} /><line {...line([0, W, 0], [0, W, H])} /><line {...line([L, 0, 0], [L, 0, H])} />
  </g>

  {labels && (
    <g class="lv-labels" aria-hidden="true">
      {ticks.map((t) => (
        <g>
          <line x1={t.x} y1={t.y} x2={t.x2} y2={t.y2} class="lv-tick" />
          <text x={t.x2} y={t.y2 - 4} text-anchor="middle" class="lv-tick-label">{t.label}</text>
        </g>
      ))}
      <line x1={dimL[0][0]} y1={dimL[0][1]} x2={dimL[1][0]} y2={dimL[1][1]} class="lv-dim" />
      <text x={(dimL[0][0] + dimL[1][0]) / 2 - 18} y={(dimL[0][1] + dimL[1][1]) / 2 + 16} class="lv-dim-label">12 ft</text>
      <line x1={dimW[0][0]} y1={dimW[0][1]} x2={dimW[1][0]} y2={dimW[1][1]} class="lv-dim" />
      <text x={(dimW[0][0] + dimW[1][0]) / 2 + 8} y={(dimW[0][1] + dimW[1][1]) / 2 + 10} class="lv-dim-label">6½ ft</text>
    </g>
  )}
</svg>

<style>
  .loadviz { width: 100%; height: auto; overflow: visible; }
  .lv-shadow { fill: rgb(18 19 17 / 0.06); }
  .lv-cab polygon { fill: var(--paper-2); stroke: rgb(18 19 17 / 0.28); stroke-width: 1; stroke-linejoin: round; }
  .lv-cab polygon:nth-child(2) { fill: var(--paper-3); }
  .lv-back { fill: rgb(18 19 17 / 0.035); stroke: rgb(18 19 17 / 0.14); stroke-width: 1; stroke-dasharray: 3 3; }
  .lv-back--2 { fill: rgb(18 19 17 / 0.06); }
  .lv-floor { fill: #e4e1d9; }
  .lv-fill-top { fill: #62dc7a; }
  .lv-fill-side { fill: var(--green); }
  .lv-fill-end { fill: #2ea648; }
  .lv-fill polygon { stroke: rgb(18 19 17 / 0.25); stroke-width: 0.75; stroke-linejoin: round; }
  .lv-edges line { stroke: var(--ink); stroke-width: 1.4; stroke-linecap: round; }
  .lv-wheels circle { fill: var(--asphalt); stroke: var(--asphalt); stroke-width: 1; }
  .lv-wheels .lv-hub { fill: var(--paper-3); stroke: none; }
  .lv-chassis polygon { fill: var(--asphalt-3); stroke: var(--asphalt-3); stroke-width: 0.5; }
  .lv-window { fill: rgb(18 19 17 / 0.16) !important; stroke: none !important; }
  .lv-tick { stroke: var(--ink-3); stroke-width: 1; }
  .lv-tick-label, .lv-dim-label { font-family: var(--mono); font-size: 9.5px; fill: var(--ink-3); letter-spacing: 0.04em; }
  .lv-dim { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 2 3; }

  .loadviz--dark .lv-shadow { fill: rgb(0 0 0 / 0.25); }
  .loadviz--dark .lv-cab polygon { fill: var(--asphalt-2); stroke: rgb(255 255 255 / 0.22); }
  .loadviz--dark .lv-cab polygon:nth-child(2) { fill: var(--asphalt-3); }
  .loadviz--dark .lv-back { fill: rgb(255 255 255 / 0.03); stroke: rgb(255 255 255 / 0.16); }
  .loadviz--dark .lv-floor { fill: #22241f; }
  .loadviz--dark .lv-edges line { stroke: var(--on-dark); }
  .loadviz--dark .lv-wheels circle { fill: #000; stroke: rgb(255 255 255 / 0.3); }
  .loadviz--dark .lv-chassis polygon { fill: #000; }
  .loadviz--dark .lv-tick { stroke: var(--on-dark-3); }
  .loadviz--dark .lv-tick-label, .loadviz--dark .lv-dim-label { fill: var(--on-dark-3); }
  .loadviz--dark .lv-dim { stroke: var(--on-dark-3); }
</style>
