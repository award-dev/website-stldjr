---
// Real reviews only. Manual entries from config/reviews.json, or live Google
// reviews via /api/reviews when source is "google-places".
import Icon from "./Icon.astro";
import OwnerNote from "./OwnerNote.astro";
import { reviews, business } from "../lib/site";

type R = { name: string; rating: number; text: string; date?: string | null; url?: string | null };
const items = (reviews.items as R[]).filter((r) => r.name && r.text && r.rating);
const profile = business.links.googleReviewUrl || business.links.googleBusinessProfile;
const fmt = (d?: string | null) => (d ? new Date(d).toLocaleDateString("en-US", { month: "short", year: "numeric" }) : "");
const live = reviews.source === "google-places";
---
<div class="reviews" data-reviews={live ? "live" : undefined}>
  {items.length > 0 && (
    <ul role="list" class="rv-list">
      {items.map((r, i) => (
        <li class="rv card" data-reveal style={`--i:${i % 3}`}>
          <p class="rv-stars" aria-label={`${r.rating} out of 5 stars`}>{Array.from({ length: 5 }, (_, s) => <Icon name="star" size={16} class={s < r.rating ? "on" : "off"} />)}</p>
          <blockquote class="rv-text">{r.text}</blockquote>
          <p class="rv-meta small"><span class="rv-name">{r.name}</span>{r.date && <span class="muted"> · {fmt(r.date)}</span>}<span class="muted"> · Google</span></p>
        </li>
      ))}
    </ul>
  )}

  {items.length === 0 && (
    <div class="rv-empty" data-rv-empty>
      <p class="h4">We'd rather show you real reviews than write our own.</p>
      <p class="muted">{profile ? "Read what St. Louis customers say on Google." : "Reviews from our Google Business Profile will appear here."}</p>
      {profile && <a class="btn btn--ghost" href={profile} target="_blank" rel="noopener">See our Google reviews <Icon name="arrow" class="arrow" /></a>}
    </div>
  )}

  {live && (
    <div class="rv-live" data-rv-live-wrap hidden>
      <p class="rv-summary"><span class="h4" data-rv-rating></span> <span class="muted" data-rv-count></span> <a class="link" data-rv-all target="_blank" rel="noopener">See all on Google</a></p>
      <ul role="list" class="rv-list" data-rv-live></ul>
    </div>
  )}

  {items.length === 0 && !live && (
    <OwnerNote>Paste real Google reviews into config/reviews.json (word for word), or set source to "google-places" with GOOGLE_PLACES_API_KEY + GOOGLE_PLACE_ID. Also add links.googleReviewUrl.</OwnerNote>
  )}
</div>

<style>
  .reviews { display: grid; gap: 24px; }
  .rv-list { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .rv { padding: 24px; display: grid; gap: 14px; align-content: start; }
  .reviews :global(.rv) { padding: 24px; display: grid; gap: 14px; align-content: start; }
  .rv-stars, .reviews :global(.rv-stars) { display: flex; gap: 2px; color: var(--ink); }
  .rv-stars :global(.off) { opacity: 0.2; }
  .rv-text, .reviews :global(.rv-text) { font-size: 1.02rem; line-height: 1.55; }
  .rv-name { font-weight: 580; }
  .rv-live { display: grid; gap: 16px; }
  .rv-summary { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
  .rv-empty { display: grid; gap: 12px; justify-items: start; padding: clamp(24px, 4vw, 40px); border: 1px dashed var(--line-strong); border-radius: var(--r-4); }
</style>

{live && (
  <script>
    const wrap = document.querySelector<HTMLElement>("[data-rv-live-wrap]");
    const list = document.querySelector<HTMLElement>("[data-rv-live]");
    const empty = document.querySelector<HTMLElement>("[data-rv-empty]");
    const esc = (s: string) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    const stars = (n: number) => {
      const k = Math.max(0, Math.min(5, Math.round(n || 0)));
      return `${"\u2605".repeat(k)}<span style="opacity:.2">${"\u2605".repeat(5 - k)}</span>`;
    };
    fetch("/api/reviews")
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!wrap || !list || !d || d.status !== "ok" || !d.reviews.length) return;
        const shown = d.reviews.filter((r: any) => r.text);
        if (!shown.length) return;
        list.innerHTML = shown
          .map((r: any) => {
            // Google asks that each review credit its author, linking to them.
            const who = r.url ? `<a class="link" href="${esc(r.url)}" target="_blank" rel="noopener"><b>${esc(r.name)}</b></a>` : `<b>${esc(r.name)}</b>`;
            return `<li class="card rv"><p class="rv-stars" aria-label="${r.rating} out of 5 stars">${stars(r.rating)}</p><blockquote class="rv-text">${esc(r.text)}</blockquote><p class="small">${who}<span class="muted"> · ${esc(r.relative || "")} · Google</span></p></li>`;
          })
          .join("");
        const rating = wrap.querySelector<HTMLElement>("[data-rv-rating]");
        const count = wrap.querySelector<HTMLElement>("[data-rv-count]");
        const all = wrap.querySelector<HTMLAnchorElement>("[data-rv-all]");
        if (rating && d.rating) rating.innerHTML = `${Number(d.rating).toFixed(1)} ${stars(d.rating)}`;
        if (count && d.count) count.textContent = `from ${d.count} Google review${d.count === 1 ? "" : "s"} ·`;
        if (all) { if (d.url) all.href = d.url; else all.remove(); }
        wrap.hidden = false;
        if (empty) empty.hidden = true;
      })
      .catch(() => {});
  </script>
)}
