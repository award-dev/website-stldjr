---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Faq from '../../../components/Faq.astro';
import InteriorBody from '../../../components/seo/InteriorBody.astro';
import BathroomBody from '../../../components/seo/BathroomBody.astro';
import KitchenBody from '../../../components/seo/KitchenBody.astro';
import CommercialBody from '../../../components/seo/CommercialBody.astro';
import { subservices, subPath, type SubService } from '../../../data/subservices';
import { site } from '../../../data/site';
import { faqItems, faqSchema } from '../../../lib/site';
import StCharlesCounty from '../../../components/seo/StCharlesCounty.astro';

export function getStaticPaths() {
  return subservices.map((sub) => ({ params: { service: sub.parent, sub: sub.slug }, props: { sub } }));
}
interface Props { sub: SubService }
const { sub } = Astro.props;
const parentName = 'Demolition';
const url = `${site.url}${subPath(sub)}`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: parentName, href: `/services/${sub.parent}/` },
  { name: sub.name, href: subPath(sub) },
];
const faqs = faqItems(sub.faqIds);
const siblings = subservices.filter((s) => s.parent === sub.parent && s.slug !== sub.slug);
const bodies = {
  'interior-demolition': InteriorBody,
  'bathroom-demolition': BathroomBody,
  'kitchen-demolition': KitchenBody,
  'commercial-interior-demolition': CommercialBody,
};
const Body = bodies[sub.slug as keyof typeof bodies];
const serviceSchema = {
  '@type': 'Service',
  '@id': `${url}#service`,
  name: sub.name,
  serviceType: sub.serviceType,
  description: sub.intro,
  url,
  provider: { '@id': `${site.url}/#business` },
  areaServed: site.serviceArea.map((a) => ({ '@type': a.type, name: `${a.name}, ${site.region}` })),
  isRelatedTo: { '@id': `${site.url}/services/${sub.parent}/#service` },
};
const arrow = '<svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
---
<Base title={sub.metaTitle} description={sub.metaDescription} ogImage={sub.cover} breadcrumbs={crumbs} schema={[serviceSchema, ...(faqs.length ? [faqSchema(faqs)] : [])]}>
  <PageHero title={sub.h1} lead={sub.intro} crumbs={crumbs} photo={sub.cover}>
    <div class="btn-row">
      <a href="/quote/?service=demolition" class="btn btn-accent" data-track="cta_click" data-track-cta="quote" data-track-location={`sub-${sub.slug}`}>Send photos for a quote<Fragment set:html={arrow} /></a>
      <a href={site.phoneHref} class="btn btn-ghost" data-track="phone_click" data-track-location={`sub-${sub.slug}`}>Call {site.phone}</a>
    </div>
  </PageHero>
  <Body />
  {faqs.length > 0 && (
    <section class="section-tight" aria-labelledby="faq-h">
      <div class="shell faq-split">
        <div class="head"><h2 id="faq-h" class="display-md">{sub.name} questions</h2></div>
        <Faq items={faqs} />
      </div>
    </section>
  )}
  <StCharlesCounty />
  <section class="section-tight" aria-labelledby="related-h">
    <div class="shell depth">
      <h2 id="related-h" class="display-md">Related work</h2>
      <ul class="related">
        <li><a class="link-u accent" href={`/services/${sub.parent}/`}>Demolition contractor in St. Louis</a></li>
        {siblings.map((s) => <li><a class="link-u accent" href={subPath(s)}>{s.h1}</a></li>)}
        <li><a class="link-u accent" href="/services/construction-debris-removal/">Haul remodel debris without a tear-out</a></li>
        <li><a class="link-u accent" href="/pricing/">Junk removal prices by the load</a></li>
        <li><a class="link-u accent" href="/service-areas/">Cities we serve</a></li>
      </ul>
    </div>
  </section>
</Base>
<style>
  .depth { display: grid; gap: 16px; max-width: 78ch; }
  .related { margin: 0; padding-left: 1.1em; display: grid; gap: 8px; }
  .faq-split { display: grid; gap: 32px 64px; }
  @media (min-width: 1024px) { .faq-split { grid-template-columns: 5fr 7fr; } }
</style>
