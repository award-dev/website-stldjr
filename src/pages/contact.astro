---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { content } from '../data/content';
import { hoursSummary } from '../lib/site';
const pg = content.pages.contact;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Contact', href: '/contact/' }];
const contactPage = { '@type': 'ContactPage', name: 'Contact', url: `${site.url}/contact/`, about: { '@id': `${site.url}/#business` } };
const arrow = '<svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
---
<Base title={pg.title} description={pg.description} breadcrumbs={crumbs} schema={[contactPage]} cta={false}>
  <PageHero title={pg.heading} lead={pg.lead} crumbs={crumbs} />

  <section class="shell contact" aria-label="Contact details">
    <div class="details" data-reveal>
      <a class="card call" href={site.phoneHref} data-track="phone_click" data-track-location="contact">
        <span class="label">Call or text</span>
        <span class="big">{site.phone}</span>
      </a>
      <a class="card" href={`mailto:${site.email}`}>
        <span class="muted">Email</span>
        <span class="email">{site.email}</span>
      </a>
      <div class="card">
        <span class="muted">Hours</span>
        {hoursSummary().map((h) => <span>{h.days} · {h.hours}</span>)}
      </div>
      <a class="card" href="/service-area/">
        <span class="muted">Service area</span>
        <span>St. Louis City, St. Louis County and St. Charles County</span>
      </a>
    </div>

    <div class="paths" data-reveal style="--d:80ms">
      <a class="path" href="/book/" data-track="cta_click" data-track-cta="book" data-track-location="contact">
        <span class="tag"><span class="dot"></span>Fastest</span>
        <h2 class="display-md">Book a pickup</h2>
        <p class="muted">Pick a load size, see the price, add photos and choose an open arrival window. You get a confirmation with links to reschedule or cancel.</p>
        <span class="link-arrow">Start booking<Fragment set:html={arrow} /></span>
      </a>
      <a class="path" href="/quote/" data-track="cta_click" data-track-cta="quote" data-track-location="contact">
        <span class="tag"><span class="dot"></span>Not sure yet?</span>
        <h2 class="display-md">Send photos for a free quote</h2>
        <p class="muted">Demolition, big cleanouts or anything unusual: tell us about the job and send a few photos. We get back to you with a price.</p>
        <span class="link-arrow">Get a quote<Fragment set:html={arrow} /></span>
      </a>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; gap: 24px; padding-bottom: clamp(64px, 8vw, 120px); }
  @media (min-width: 1024px) { .contact { grid-template-columns: 5fr 7fr; align-items: start; } }
  .details, .paths { display: grid; gap: 12px; }
  .card { display: grid; gap: 6px; padding: 26px 28px; border-radius: var(--radius-lg); background: var(--color-card); box-shadow: inset 0 0 0 1px var(--color-line); transition: background-color .3s, transform .45s var(--ease-out-expo); }
  a.card:hover { background: var(--color-card-2); transform: translateY(-3px); }
  .card .muted, .card .label { font-size: 14px; }
  .big { font-family: var(--font-display); font-weight: 650; font-size: clamp(2rem, 1.5rem + 2vw, 2.8rem); letter-spacing: -0.03em; line-height: 1; }
  .call { background: var(--color-accent); color: var(--color-on-accent); box-shadow: none; }
  .call .label { font-weight: 600; }
  a.call:hover { background: var(--color-accent-2); }
  .email { overflow-wrap: anywhere; font-size: 18px; }
  .path { display: grid; gap: 16px; padding: clamp(28px, 4vw, 44px); border-radius: var(--radius-xl); background: radial-gradient(120% 140% at 100% 0%, rgb(var(--accent-rgb) / .14), transparent 60%), var(--color-card); box-shadow: inset 0 0 0 1px var(--color-line); transition: transform .45s var(--ease-out-expo), box-shadow .3s; }
  .path:hover { transform: translateY(-3px); box-shadow: inset 0 0 0 1px rgb(var(--accent-rgb) / .5); }
  .path h2 { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.2rem); }
</style>
