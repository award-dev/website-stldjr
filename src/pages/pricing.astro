---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import LoadConfigurator from "../components/LoadConfigurator.astro";
import LoadGuide from "../components/LoadGuide.astro";
import FaqList from "../components/FaqList.astro";
import FinalCta from "../components/FinalCta.astro";
import OwnerNote from "../components/OwnerNote.astro";
import { pricing, loads, minimum, anyPrice, abs } from "../lib/site";
const schema = anyPrice ? [{
  "@type": "OfferCatalog",
  name: "Junk removal by the load",
  itemListElement: [...(minimum ? [{ "@type": "Offer", name: "Minimum pickup (a few small items)", price: minimum.price, priceCurrency: pricing.currency, seller: { "@id": abs("/#business") } }] : []), ...loads.filter((l) => l.price).map((l) => ({ "@type": "Offer", name: `${l.label} (${l.yards} cubic yards)`, price: l.price, priceCurrency: pricing.currency, seller: { "@id": abs("/#business") } }))],
}] : [];
---
<Base title="Junk Removal Pricing in St. Louis — By the Load" description={`How junk removal pricing works: 1/4, 1/2, 3/4 or a full ${pricing.maxCubicYards}-cubic-yard truck. See what fits in each load and everything that can change the price.`} schema={schema}>
  <PageHero eyebrow="Pricing" title="You pay for the space it takes up." lede={`Our truck holds ${pricing.maxCubicYards} cubic yards. Pick how much of it you'll fill — a quarter, half, three-quarters, or all of it. That's the price — loading and hauling included. Just a few small items? There's a $125 minimum pickup.`} crumbs={[{ href: "/pricing/", label: "Pricing" }]} />

  <section class="section">
    <div class="wrap cfg-grid">
      <div class="stack" style="--stack: 20px">
        <p class="eyebrow">Try it</p>
        <h2 class="h2">Pick a size. See the price.</h2>
        <p class="lede">Can't decide between two sizes? Book the smaller one and upload photos. If it won't fit, we tell you before we load.</p>
        <table class="ptable">
          <caption class="sr-only">Load sizes and prices</caption>
          <thead><tr><th scope="col">Load</th><th scope="col">Volume</th><th scope="col">Price</th></tr></thead>
          <tbody>
            {minimum && <tr><th scope="row">{minimum.label}</th><td>A few small items</td><td>{minimum.priceLine.label}</td></tr>}
            {loads.map((l) => <tr><th scope="row">{l.label}</th><td class="num">{l.yards} yd³</td><td>{l.priceLine.label}</td></tr>)}
          </tbody>
        </table>
      </div>
      <LoadConfigurator variant="full" idPrefix="pricing" />
    </div>
  </section>

  <section class="section paper-2">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">What fits</p><h2 class="h2">Roughly what each load looks like.</h2></div>
      <LoadGuide />
    </div>
  </section>

  <section class="section" id="what-changes-the-price">
    <div class="wrap cond-grid">
      <div class="section-head">
        <p class="eyebrow">The fine print, not so fine</p>
        <h2 class="h2">What can change the price.</h2>
        <p class="lede">None of this is hidden. If something on this list applies to your job, we'll say so before we start.</p>
      </div>
      <div>
        <ol role="list" class="conds">
          {pricing.conditions.map((c, i) => <li><span class="meta num muted">{String(i + 1).padStart(2, "0")}</span><p>{c}</p></li>)}
        </ol>
        {pricing.ownerNotes.map((n) => <OwnerNote class="p-note">{n}</OwnerNote>)}
      </div>
    </div>
  </section>

  <section class="section paper-2">
    <div class="wrap faq-grid">
      <div class="section-head"><p class="eyebrow">Questions</p><h2 class="h2">Pricing questions.</h2></div>
      <FaqList ids={["pricing", "load-size", "yards", "more-than-expected", "estimates"]} />
    </div>
  </section>
  <FinalCta />
</Base>

<style>
  .cfg-grid, .cond-grid, .faq-grid { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 1020px) { .cfg-grid { grid-template-columns: 1fr 1fr; gap: 64px; } .cond-grid, .faq-grid { grid-template-columns: 0.8fr 1.2fr; gap: 64px; } }
  .ptable { width: 100%; border-collapse: collapse; margin-top: 12px; }
  .ptable th, .ptable td { text-align: left; padding: 14px 8px 14px 0; border-bottom: 1px solid var(--line); }
  .ptable thead th { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); font-weight: 500; }
  .ptable tbody th { font-weight: 580; }
  .conds { display: grid; border-top: 1px solid var(--line); }
  .conds li { display: grid; grid-template-columns: 44px 1fr; gap: 12px; padding: 20px 0; border-bottom: 1px solid var(--line); font-size: 1.05rem; }
  :global(.p-note) { margin-top: 12px; display: flex; }
</style>
