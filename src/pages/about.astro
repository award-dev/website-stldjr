---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { jobImage, projectFor, fitWidths, PHOTO_QUALITY } from '../lib/images';
import { site, primaryAction, secondaryAction } from '../data/site';
import { content } from '../data/content';
import { business, pricing, hoursSummary } from '../lib/site';

const a = content.about;
const truck = projectFor('crew/truck.webp');
const t = business.trust;
const facts = [
  t.foundedYear && ['In business since', String(t.foundedYear)],
  t.completedJobs && ['Jobs completed', String(t.completedJobs)],
  t.insured && ['Insurance', t.insuranceDetails ? `Fully insured, ${t.insuranceDetails}` : 'Insured'],
  t.licensed && ['Licensing', t.licenseDetails || 'Licensed'],
  ['Truck capacity', `${pricing.maxCubicYards} cubic yards`],
  ['Based in', `${site.city}, Missouri`],
].filter(Boolean) as [string, string][];
const crumbs = [{ name: 'Home', href: '/' }, { name: 'About', href: '/about/' }];
const aboutPage = {
  '@type': 'AboutPage',
  name: a.metaTitle,
  url: `${site.url}/about/`,
  about: { '@id': `${site.url}/#business` },
  mainEntity: {
    '@type': 'Person',
    name: site.owner,
    jobTitle: 'Founder',
    worksFor: { '@id': `${site.url}/#business` },
  },
};
---
<Base title={a.metaTitle} description={a.description} breadcrumbs={crumbs} schema={[aboutPage]} ogImage={a.photo}>
  <PageHero title={a.title} lead={a.lead} crumbs={crumbs} photo={a.photo} />

  <section class="section-tight" aria-labelledby="why-h">
    <div class="shell story">
      <div class="story__text">
        <h2 id="why-h" class="display-md" data-reveal>Why we do this</h2>
        {a.story.map((p, i) => <p data-reveal style={`--d:${i * 60}ms`}>{p}</p>)}
        <p class="signoff" data-reveal>{site.owner}, founder</p>
      </div>
      <ul class="trades">
        {a.twoTrades.map(([h, p], i) => (
          <li data-reveal style={`--d:${i * 80}ms`}><h3 class="title">{h}</h3><p class="muted">{p}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="facts-h">
    <div class="shell">
      <div class="head" data-reveal><h2 id="facts-h" class="display-md">Facts, not adjectives</h2></div>
      <dl class="facts">
        {facts.map(([k, v], i) => <div data-reveal style={`--d:${(i % 3) * 70}ms`}><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="visit-h">
    <div class="shell visit">
      <div class="media visit__photo" data-reveal>
        <Image src={jobImage(truck.file)} alt={truck.alt} widths={fitWidths(jobImage(truck.file), [640, 960, 1280, 1600])} quality={PHOTO_QUALITY} sizes="(min-width: 1024px) 720px, 100vw" />
      </div>
      <div class="visit__text" data-reveal style="--d:80ms">
        <h2 id="visit-h" class="display-md">Talk to us</h2>
        <p class="lead">Call for anything that doesn't fit a form. Or skip the call and book online.</p>
        <dl class="hours">
          {hoursSummary().map((h) => <div><dt>{h.days}</dt><dd>{h.hours}</dd></div>)}
        </dl>
        <div class="btn-row">
          <a href={primaryAction.href} class="btn btn-accent">{primaryAction.label}</a>
          <a href={secondaryAction.href} class="btn btn-ghost">{secondaryAction.label}</a>
        </div>
        <a href={site.phoneHref} class="link-arrow" data-track="phone_click" data-track-location="about">Call {site.phone}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .story { display: grid; gap: 48px 80px; align-items: start; }
  @media (min-width: 1024px) { .story { grid-template-columns: 7fr 5fr; } .trades { position: sticky; top: calc(var(--nav-h) + 24px); } }
  .story__text { display: grid; gap: 22px; max-width: 68ch; }
  .story__text p { color: #d6cfc6; font-size: 1.075rem; }
  .story__text .signoff { color: var(--color-accent-ink); font-weight: 600; }
  .trades { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .trades li { display: grid; gap: 10px; padding: 28px; border-radius: var(--radius-lg); background: var(--color-card); box-shadow: inset 0 0 0 1px var(--color-line); }
  .facts { margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .facts div { display: grid; gap: 10px; padding: 26px 28px; border-radius: var(--radius-lg); background: var(--color-card); box-shadow: inset 0 0 0 1px var(--color-line); }
  .facts dt { font-size: 14px; color: var(--color-muted); }
  .facts dd { margin: 0; font-family: var(--font-display); font-weight: 650; font-size: clamp(1.4rem, 1.2rem + .8vw, 1.9rem); letter-spacing: -0.03em; line-height: 1.1; }
  .visit { display: grid; gap: 40px 64px; align-items: center; }
  @media (min-width: 1024px) { .visit { grid-template-columns: 1.1fr 1fr; } }
  .visit__photo { aspect-ratio: 4 / 3; }
  .visit__text { display: grid; gap: 22px; justify-items: start; }
  .hours { margin: 0; display: grid; gap: 6px; }
  .hours div { display: flex; gap: 16px; }
  .hours dt { min-width: 80px; color: var(--color-muted); }
  .hours dd { margin: 0; font-variant-numeric: tabular-nums; }
</style>
