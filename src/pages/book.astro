---
import Base from "../layouts/Base.astro";
import BookingFlow from "../components/BookingFlow.astro";
---
<Base title="Book a Pickup Online" description="Book junk removal, a cleanout or demolition in St. Louis. Choose a load size, see the price, add photos and pick an open arrival window." hideMobileBar>
  <div class="wrap book-page">
    <BookingFlow mode="book" />
  </div>
</Base>

<style>
  .book-page { padding: 8px 0 64px; min-height: 70vh; }
</style>
