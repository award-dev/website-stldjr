---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page not found" description="The page you were looking for could not be found." noindex>
  <PageHero title="This page is not here" lead="The page you are looking for does not exist or has moved.">
    <div class="btn-row">
      <a href="/" class="btn btn-accent">Go to the home page</a>
      <a href="/projects/" class="btn btn-ghost">See our projects</a>
    </div>
  </PageHero>
</Base>
