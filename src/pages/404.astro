---
import Base from "../layouts/Base.astro";
import { business, telHref } from "../lib/site";
---
<Base title="Page Not Found" description="That page doesn't exist." noindex>
  <section class="section nf">
    <div class="wrap stack" style="--stack: 24px">
      <p class="eyebrow">404</p>
      <h1 class="display">Already hauled away.</h1>
      <p class="lede">That page isn't here. Try one of these instead.</p>
      <div class="cta-row">
        <a href="/" class="btn btn--lg">Home</a>
        <a href="/pricing/" class="btn btn--ghost btn--lg">Pricing</a>
        <a href="/book/" class="btn btn--green btn--lg">Book a pickup</a>
      </div>
      <p class="muted">Or call <a class="link" href={telHref}>{business.phoneDisplay}</a>.</p>
    </div>
  </section>
</Base>
<style>.nf { min-height: 60vh; }</style>
