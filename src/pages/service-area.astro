---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ServiceAreaBlock from "../components/ServiceAreaBlock.astro";
import { business, telHref } from "../lib/site";
---
<Base title="Service Area: St. Louis & St. Charles County" breadcrumbs={[{ name: "Home", href: "/" }, { name: "Service area", href: "/service-area/" }]} description="Junk removal, cleanouts and demolition in St. Louis City, St. Louis County and St. Charles County — from Soulard to Chesterfield to O'Fallon. Check your ZIP.">
  <PageHero title="From the riverfront to the far side of the Missouri" lead="Junk removal, cleanouts and demolition across St. Louis City, St. Louis County and St. Charles County." crumbs={[{ name: "Home", href: "/" }, { name: "Service area", href: "/service-area/" }]} photo="crew/truck.webp" />
  <section class="section-tight">
    <div class="shell">
      <ServiceAreaBlock full />
    </div>
  </section>
  <section class="section-tight">
    <div class="shell edge">
      <h2 class="display-md">Just outside the list?</h2>
      <p class="lead">If you're close to anywhere on this list, call <a class="link-u accent" href={telHref}>{business.phoneDisplay}</a> and ask.</p>
    </div>
  </section>
</Base>
<style>
  .edge { display: grid; gap: 12px; max-width: 720px; }
</style>
